# Copy to .env and fill in. .env is gitignored — never commit secrets.

# Postgres — matches docker-compose.yml defaults
DATABASE_URL=postgresql://hybridrag:hybridrag@localhost:5432/hybridrag

# GitHub Models — embeddings + LLM generation
# Get a fine-grained PAT with "Models" scope at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Cohere — used by hybrid_rerank mode. Free trial key gives ~1000 reranks/month.
# Get one at: https://cohere.com/  →  Dashboard  →  API keys  →  Create Trial key
COHERE_API_KEY=

# Langfuse — LLM observability (traces for retrieval + answer generation).
# Sign up at https://cloud.langfuse.com and grab a project's public/secret keys.
# Leave blank to disable tracing — the app runs normally without these.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
